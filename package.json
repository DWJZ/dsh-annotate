{
  "name": "dsh-annotate",
  "version": "0.1.0",
  "description": "DeepSeek Harness \u7684\u56de\u7b54\u6807\u6ce8\u63d2\u4ef6\uff1a\u9009\u4e2d\u52a9\u624b\u56de\u7b54\u91cc\u7684\u6587\u5b57\u5199\u4e0b\u5907\u6ce8\uff0c\u6512\u591f\u4e86\u4e00\u6b21\u6027\u53d1\u7ed9 agent\u3002 / Annotate a DeepSeek Harness answer: select text, leave a comment per selection, and send the whole set as one message.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DWJZ/dsh-annotate.git"
  },
  "homepage": "https://github.com/DWJZ/dsh-annotate#readme",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "test": "node test/annotate.spec.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "annotation",
    "annotate",
    "notes"
  ],
  "bugs": {
    "url": "https://github.com/DWJZ/dsh-annotate/issues"
  }
}
